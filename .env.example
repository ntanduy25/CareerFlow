PROJECT_NAME="CareerFlow API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Secret key for JWT signing (generate a secure random string for production)
SECRET_KEY="careerflow-super-secret-development-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database connection:
# SQLite (default for instant zero-config local run):
DATABASE_URL="sqlite:///./careerflow.db"
# PostgreSQL (for Docker / Production):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careerflow"

# Allowed CORS origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'
